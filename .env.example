# Copy to .env and fill in your keys. The app reads these at startup and fails fast if missing.
# The values are NEVER read or logged anywhere except when calling the APIs.

OPENAI_API_KEY=
EXA_API_KEY=

# optional — defaults to gpt-5.1
# OPENAI_MODEL=

# --- orchestrator (Go control plane) ---
# The spawn tool RPCs to the orchestrator; the orchestrator calls back into the in-process
# Node worker. Run the Go binary separately (cd orchestrator && go run .) — defaults match.
# ORCHESTRATOR_URL=http://localhost:8787   # where the Go orchestrator listens
# WORKER_PORT=8788                         # in-process worker port (Go's WORKER_URL must match)
# ROOT_DEADLINE_MS=300000                  # hard wall-clock cap on a whole root run
# ORCH_MAX_CONCURRENCY=3                   # max sub-agents in flight at once
# ORCH_PER_TASK_TIMEOUT_MS=90000           # per-attempt timeout for one sub-agent
# ORCH_RETRY_BUDGET=1                      # silent retries on transport failure
